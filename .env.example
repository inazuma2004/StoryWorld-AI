# Fournisseurs de texte : mock | gemini | ollama
STORYWORLD_TEXT_PROVIDER=mock

# Fournisseurs d'images : mock | hf | pollinations
STORYWORLD_IMAGE_PROVIDER=mock

# Clés API (laisser vide avec les providers mock)
STORYWORLD_GEMINI_API_KEY=
STORYWORLD_HF_TOKEN=
# Optionnel : Pollinations fonctionne sans clé, mais un token évite les quotas anonymes
STORYWORLD_POLLINATIONS_TOKEN=

# URL de l'instance Ollama locale
STORYWORLD_OLLAMA_BASE_URL=http://localhost:11434

# Répertoire des données (base SQLite, images, exports)
STORYWORLD_DATA_DIR=data
